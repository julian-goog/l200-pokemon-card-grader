# PokéGrade AI — Environment Configuration Template
# Copy to `.env` for local overrides. Never commit real credentials or `.env` files.
# Production secrets (e.g., TCG_MARKET_API_KEY) are retrieved dynamically from
# Google Cloud Secret Manager via `app/tools/secret_manager.py` (SecretManagerService).

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
POKEGRADE_ENV=local

# Optional feature toggles (defaults to false in offline/local testing)
ENABLE_CLOUD_DLP_API=false
ENABLE_CLOUD_TRACE_EXPORT=false
ENABLE_VERTEX_AI_SEARCH=false
